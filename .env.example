# Copy to .env for local development. .env is git-ignored.
# Real environment variables always take precedence over .env.
# List every supported secret here with a safe placeholder value.

# Example API token (optional).
JOEDOCS_API_TOKEN=replace-me

# The admin token for a remote server's admin API (`joedocs login`), as
# printed once by `joedocs admin-token create` on the server. Read it from a
# password manager rather than keeping it here.
JOEDOCS_ADMIN_TOKEN=replace-me
